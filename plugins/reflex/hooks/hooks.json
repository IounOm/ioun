{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" session-rules.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" git-gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*supabase.*__(execute_sql|apply_migration)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\" supabase-destructive-guard.py"
          }
        ]
      }
    ]
  }
}
