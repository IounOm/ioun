{
  "mcpServers": {
    "shadcn": {
      "command": "bun",
      "args": ["./node_modules/shadcn/dist/index.js", "mcp", "--cwd", "packages/ui"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.13.0",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    }
  }
}
